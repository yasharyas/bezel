{
  "name": "bezel-ui",
  "version": "0.0.1",
  "description": "Bezel is a React component library for interface work that needs motion and craft: animated navigation, scroll reveals, cursors, loaders and editorial layout primitives, shipped as readable TypeScript source.",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui-components",
    "typescript",
    "tailwindcss",
    "gsap",
    "framer-motion",
    "animation",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Yash Arya (https://yash-arya.com)",
  "homepage": "https://yash-ui-system-gallery.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasharyas/bezel.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/yasharyas/bezel/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@radix-ui/react-select": "^2.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-select": "^2.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.170.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "@gsap/react": "^2.1.2",
    "canvas-confetti": "^1.9.3",
    "motion": "^12.0.0",
    "rough-notation": "^0.5.1",
    "three": "^0.170.0"
  }
}
